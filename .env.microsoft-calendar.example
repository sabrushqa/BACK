# Copiez ce fichier vers .env.microsoft-calendar.local puis renseignez les valeurs Microsoft Entra.
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
# Générer une clé avec : openssl rand -base64 32
MICROSOFT_CALENDAR_TOKEN_ENCRYPTION_KEY=
MICROSOFT_CALENDAR_REDIRECT_URI=http://localhost:4200/commercial/calendrier
